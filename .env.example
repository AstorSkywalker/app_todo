PORT=3000

# Cambia este valor a "cloud" para usar Oracle ADB.
# Valores validos: local, cloud
ORACLE_DB_PROFILE=local

# Esta app usa Thick mode para soportar Oracle ADB con wallet/TNS.
ORACLE_USE_THICK=true

# Perfil local: Oracle Free en la VM.
ORACLE_LOCAL_USER=app_todo
ORACLE_LOCAL_PASSWORD=TU_PASSWORD_APP
ORACLE_LOCAL_CONNECT_STRING=//localhost:1521/freepdb1

# Solo se usa cuando ORACLE_USE_THICK=true.
ORACLE_CLIENT_LIB_DIR=C:\oracle_21c_client\bin
ORACLE_CLIENT_CONFIG_DIR=D:\Nelson\dev\app_todo\config\adb

# Perfil cloud: Oracle ADB. Se usa cuando ORACLE_DB_PROFILE=cloud.
ORACLE_CLOUD_USER=app_todo
ORACLE_CLOUD_PASSWORD=TU_PASSWORD_CLOUD
ORACLE_CLOUD_CONNECT_STRING=oracle23ai_low

# Auth JWT.
# Usa valores largos, aleatorios y distintos en tu .env real.
JWT_ACCESS_SECRET=CAMBIA_ESTE_SECRETO_ACCESS_LARGO
JWT_REFRESH_SECRET=CAMBIA_ESTE_SECRETO_REFRESH_LARGO
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=7
